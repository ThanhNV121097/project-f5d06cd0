# Local PostgreSQL user for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose. Use a stronger value outside local dev.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Optional published backend port.
BACKEND_PORT=8080

# Optional published frontend port.
FRONTEND_PORT=3000

# Browser-visible backend origin for frontend bundle.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side backend origin for frontend container.
API_ORIGIN=http://backend:8080
